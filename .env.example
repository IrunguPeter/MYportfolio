# Get your free access key at https://web3forms.com
# Then rename this file to .env and fill in the key
WEB3FORMS_ACCESS_KEY=your_access_key_here

# Google Apps Script web app URL for the order dashboard.
# Deploy admin/code.gs (Extensions > Apps Script > Deploy > Web app),
# then paste the /exec URL here AND in the CONFIG in script.js and admin.html.
SHEET_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec